VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_LANDING_URL=http://localhost:3000
VITE_MAPBOX_TOKEN=your-mapbox-token

# App billing origin used for Stripe success/cancel/portal return URLs.
# In local dev keep http://localhost:5173. In Vercel test/prod use your deployed app URL.
APP_BASE_URL=http://localhost:5173

# Supabase service role for authenticated billing API routes and Stripe webhook writes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe server-side billing configuration.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
VITE_STRIPE_ENABLE_AMAZON_PAY=false
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_EXPLORER=price_xxx
STRIPE_PRICE_ID_PRO_COMMIT=price_xxx
STRIPE_PRICE_ID_PRO_MONTHLY=price_xxx

# Used by the Vercel serverless function for non-France DEM tile proxy
MAPBOX_TOKEN=your-mapbox-token

# BRouter (DigitalOcean droplet).
# In PRODUCTION (Vercel): leave VITE_BROUTER_URL empty — the app will
# call /api/brouter (the serverless function in api/brouter.ts), which
# in turn proxies BROUTER_UPSTREAM. Set BROUTER_UPSTREAM in the Vercel
# dashboard to e.g. http://<DROPLET_IP>
#
# In DEV: optionally set VITE_BROUTER_URL=http://<droplet-ip> to bypass the
# proxy and call BRouter directly from the browser.
# VITE_BROUTER_URL=http://your-droplet-ip
BROUTER_UPSTREAM=http://your-droplet-ip
