VITE_APPWRITE_ENDPOINT=https://appwrite.redview.tech/v1
VITE_APPWRITE_PROJECT_ID=redview-prod
VITE_APPWRITE_DATABASE_ID=redview-db
VITE_LANDING_URL=https://redview.tech
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# App billing origin used for Stripe success/cancel/portal return URLs.
APP_BASE_URL=https://app.redview.tech

# Appwrite server-side admin API key for billing routes and Stripe webhook writes.
APPWRITE_API_KEY=your-appwrite-server-api-key
APPWRITE_ENDPOINT=https://appwrite.redview.tech/v1
APPWRITE_PROJECT_ID=redview-prod
APPWRITE_DATABASE_ID=redview-db

# Stripe server-side billing configuration.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_FOUNDER=price_xxx
STRIPE_PRICE_ID_PATRON=price_xxx

# Used by the Vercel serverless function for non-France DEM tile proxy
MAPBOX_TOKEN=your-mapbox-token

# Upstream microservices (VPS)
# Le nginx du VPS n'accepte ces chemins que depuis le VPS lui-même : en dev,
# `npm run dev` ouvre un tunnel SSH vers son port 80 et y redirige ces quatre
# amonts (scripts/start-dev-services.mjs). REDVIEW_DEV_TUNNEL=0 le désactive ;
# REDVIEW_DEV_SSH_KEY (défaut ~/.ssh/oracle_brouter.key), REDVIEW_DEV_SSH_USER
# (défaut opc) et REDVIEW_DEV_TUNNEL_PORT (défaut 18080) le règlent.
# BRouter : hôte seul, api/brouter.ts ajoute lui-même /brouter (et /brouter/profile).
BROUTER_UPSTREAM=http://your-vps-ip
POI_UPSTREAM=http://your-vps-ip/poi
WEATHER_UPSTREAM=http://your-vps-ip/weather
# Open-Meteo auto-hébergé sur le VPS (server/vps/open-meteo, derrière l'nginx
# de l'hôte) : prévisions de /api/openmeteo et historique de /api/snow-context.
# Seule source météo de ce type : jamais l'API publique api.open-meteo.com
# (usage non commercial). Sans cette variable, ces routes répondent 503.
OPENMETEO_UPSTREAM=http://your-vps-ip/openmeteo
# Météo-France public API key (portail-api.meteofrance.fr), read by
# api/meteofrance.ts (AROME snow depth, WCS) and api/snow-context.ts (snow cover
# of the avalanche bulletin, DPBRA): the application must be subscribed to both
# APIs. Without it the snow model falls back to a global model and skips the BRA.
METEOFRANCE_API_KEY=

# Observabilité (serveur de prod, server/observability.mjs + request-logging.mjs).
# Erreurs serveur → GlitchTip : DSN du projet serveur (distinct du front).
# Sans DSN, rien n'est envoyé. Niveau du journal JSON : trace|debug|info|warn|error.
SENTRY_DSN_SERVER=
LOG_LEVEL=info

# Sourcemaps du front → GlitchTip, au build Docker (scripts/upload-sourcemaps.mjs).
# Variables de BUILD Coolify ; SENTRY_AUTH_TOKEN de préférence en secret de build.
# Sans elles, l'upload est ignoré (les .map sont supprimées quand même).
SENTRY_URL=https://errors.redview.tech
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Build local de vérification : envoi des erreurs du front depuis localhost.
# VITE_SENTRY_ALLOW_LOCAL=1

# Co-édition : révocation immédiate (api/_lib/multiplayerNotify.ts → serveur
# temps réel, POST /internal/access-changed signé HMAC-SHA256). Le MÊME secret
# (≥ 32 caractères, ex. `openssl rand -hex 32`) sur l'app ET sur le service
# redview-multiplayer. Sans lui : retrait appliqué par la revérification
# périodique (≤ 15 s). URL vue depuis l'app (prod :
# https://app.redview.tech/multiplayer ; dev : http://127.0.0.1:17790).
MULTIPLAYER_INTERNAL_SECRET=
MULTIPLAYER_INTERNAL_URL=
# Serveur temps réel : origines de navigateur acceptées (défaut prod :
# https://app.redview.tech ; en dev, localhost).
# MULTIPLAYER_ALLOWED_ORIGINS=https://app.redview.tech
