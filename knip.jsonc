{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Les deux pages Vite (index.html, viewer.html) et les tests Vitest sont
  // détectés par les plugins de knip. `!` = code livré (`knip --production`).
  "entry": [
    // API publique d'une feature (CLAUDE.md : index.ts), importée ou non.
    "src/features/*/index.ts!",
    "api/**/*.ts!",
    "server.mjs!",
    "server/lib/*.mjs!",
    // Serveur temps réel de co-édition (service à part, Dockerfile.multiplayer).
    "server/multiplayer/main.ts!",
    "scripts/**/*.{mjs,ts}",
    "script-test-bench/**/*.{ts,mjs}"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "api/**/*.ts!",
    "server.mjs!",
    "server/lib/*.mjs!",
    "server/multiplayer/**/*.ts!",
    "scripts/**/*.{mjs,ts}",
    "script-test-bench/**/*.{ts,mjs}"
  ],
  "ignore": [
    // Générés (wasm-bindgen, prebuild-api-i18n).
    "src/features/fitPredictor/engine/pkg/**",
    "src/features/lidar/lib/laz/pkg/**",
    "api/_lib/translations-data.ts",
    "script-test-bench/pace-accuracy/.*-pkg/**"
  ],
  // better-sqlite3 : fixture du bench POI, dépendance du package séparé
  // server/poi-server. @fontsource-variable/rethink-sans : fichiers de police
  // référencés par les url() de src/shared/styles/typography.css (knip ne lit
  // pas les CSS).
  "ignoreDependencies": ["better-sqlite3", "@fontsource-variable/rethink-sans"],
  // Outils système lancés par les scripts de dev (BRouter, arrêt des services)
  // et par bench:server (mémoire du serveur sous Windows).
  "ignoreBinaries": ["java", "netstat", "tasklist"],
  // Tout est bloquant, exports et types inutilisés compris (642 exports et 226
  // types résorbés le 07/10/2026 : `knip --fix`, puis le code mort que tsc a
  // révélé, supprimé). Un export sans utilisateur se retire, il ne s'accumule
  // plus. Exceptions nommées ci-dessous, une raison chacune.
  "ignoreIssues": {
    // Facturation gelée (décision produit) : pas une ligne touchée avant la
    // reprise de Stripe, exports inutilisés compris.
    "src/features/projectBrowser/billing/**": ["exports", "types"],
    "src/features/projectBrowser/lib/billing/**": ["exports", "types"],
    "src/features/projectBrowser/components/subscription/**": ["exports", "types"],
    // Alias voulus : même valeur, sens différent (largeur mini du panneau
    // gauche / repli générique ; marge / espacement de la pile centrale).
    "src/pages/Dashboard/lib/constants.ts": ["duplicates"],
    // Faux React du simulateur de persistance : useLayoutEffect = useEffect.
    "script-test-bench/audit/a-mock-react.ts": ["duplicates"]
  }
}
