# Serveur temps réel de co-édition (server/multiplayer) : service Coolify à part
# (redview-multiplayer), port publié sur 127.0.0.1:17790 ; l'nginx de l'hôte
# (/etc/nginx/conf.d/app.conf) y relaie wss://app.redview.tech/multiplayer.
#
# Variables : APPWRITE_ENDPOINT, APPWRITE_PROJECT_ID, APPWRITE_API_KEY,
# APPWRITE_DATABASE_ID (stockage `appwrite`, défaut en production),
# MULTIPLAYER_PORT (17790), SENTRY_DSN_SERVER (erreurs vers GlitchTip).
#
# Mesures (salles, latences, erreurs, validation fantôme, mémoire) sur le port
# interne 17791, jamais publié ni relayé par nginx :
#   docker exec <conteneur> wget -qO- http://127.0.0.1:17791/metrics.json
#
# Arrêt (SIGTERM) : journal écrit, connexions fermées en 1012, les clients se
# reconnectent au conteneur suivant et renvoient ce qui n'était pas acquitté.
# Deux conteneurs en recouvrement ne peuvent pas écrire le même journal
# (barrière : server/multiplayer/storage.ts).
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

# Le moteur de co-édition (src/features/collab) est partagé avec l'application :
# esbuild le bundle depuis les sources (alias `@/` de tsconfig.multiplayer.json)
# dans dist-server/multiplayer.mjs, lancé sans tsx (scripts/build-server.mjs).
COPY tsconfig.json tsconfig.multiplayer.json ./
COPY scripts/build-server.mjs ./scripts/
COPY src ./src
COPY server ./server
RUN node scripts/build-server.mjs --multiplayer

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV MULTIPLAYER_PORT=17790
ENV MULTIPLAYER_METRICS_PORT=17791
ENV MULTIPLAYER_STORAGE=appwrite

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 redview

# Dépendances d'exécution (`dependencies` de package.json : ws, node-appwrite,
# fractional-indexing, Sentry…), externes au bundle.
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev

COPY --from=builder /app/dist-server/multiplayer.mjs ./dist-server/multiplayer.mjs

# Release GlitchTip (server/build-id.mjs), passée par Coolify comme pour l'app ;
# après npm ci pour ne pas invalider son cache à chaque commit.
ARG SOURCE_COMMIT=""
ENV SOURCE_COMMIT=${SOURCE_COMMIT}

USER redview

EXPOSE 17790

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:17790/health > /dev/null || exit 1

# node directement en PID 1 (SIGTERM transmis : arrêt propre).
CMD ["node", "dist-server/multiplayer.mjs"]
