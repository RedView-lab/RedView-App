    { "key": "pharmacy", "label": "Pharmacie", "group": "health", "icon": "medical", "rules": [[{ "k": "amenity", "v": "pharmacy" }]] },
    { "key": "hospital", "label": "Hôpital", "group": "health", "icon": "medical", "rules": [[{ "k": "amenity", "v": "hospital" }]] },
    { "key": "clinic", "label": "Clinique", "group": "health", "icon": "medical", "ui": false, "rules": [[{ "k": "amenity", "v": "clinic" }]] },
    { "key": "doctors", "label": "Médecin", "group": "health", "icon": "medical", "ui": false, "rules": [[{ "k": "amenity", "v": "doctors" }]] },
    { "key": "defibrillator", "label": "Défibrillateur", "group": "health", "icon": "medical", "ui": false, "rules": [[{ "k": "emergency", "v": "defibrillator" }]] },
    { "key": "police", "label": "Police / gendarmerie", "group": "health", "icon": "police", "ui": false, "rules": [[{ "k": "amenity", "v": "police" }]] },

    { "key": "train_station", "label": "Gare", "group": "transport", "icon": "transport", "rules": [[{ "k": "railway", "in": ["station", "halt"] }], [{ "k": "public_transport", "v": "station" }, { "k": "train", "v": "yes" }]] },
    { "key": "bus_station", "label": "Gare routière", "group": "transport", "icon": "transport", "ui": false, "rules": [[{ "k": "amenity", "v": "bus_station" }]] },
    { "key": "ferry_terminal", "label": "Terminal ferry", "group": "transport", "icon": "transport", "rules": [[{ "k": "amenity", "v": "ferry_terminal" }]] },

    { "key": "toilets", "label": "Toilettes", "group": "services", "icon": "toilets", "rules": [[{ "k": "amenity", "v": "toilets" }]] },
    { "key": "shower", "label": "Douche", "group": "services", "icon": "toilets", "rules": [[{ "k": "amenity", "v": "shower" }]] },
    { "key": "fuel", "label": "Station-service", "group": "services", "icon": "fuel", "rules": [[{ "k": "amenity", "v": "fuel" }]] },
