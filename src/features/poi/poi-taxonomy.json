    { "key": "compressed_air", "label": "Gonflage", "group": "bike", "icon": "bicycle", "rules": [[{ "k": "amenity", "v": "compressed_air" }], [{ "k": "service:bicycle:pump", "v": "yes" }]] },
    { "key": "charging_station", "label": "Recharge électrique", "group": "bike", "icon": "fuel", "rules": [[{ "k": "amenity", "v": "charging_station" }]] },
