    { "key": "ice_cream", "label": "Glacier", "group": "food", "icon": "fast_food", "rules": [[{ "k": "amenity", "v": "ice_cream" }], [{ "k": "shop", "v": "ice_cream" }]] },
    { "key": "vending_machine", "label": "Distributeur", "group": "food", "icon": "shop", "rules": [[{ "k": "amenity", "v": "vending_machine" }, { "k": "vending", "in": ["drinks", "coffee", "food", "water", "milk", "sandwiches", "sweets", "ice_cream", "hot_drinks"] }]] },

    { "key": "hotel", "label": "Hôtel / hébergement", "group": "sleep", "icon": "hotel", "rules": [[{ "k": "tourism", "in": ["hotel", "motel", "hostel", "guest_house", "chalet", "apartment", "apartments", "aparthotel"] }]] },
