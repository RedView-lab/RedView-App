# https://editorconfig.org — shared editor defaults (line endings are left to Git).
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{rs,py}]
indent_size = 4

[Makefile]
indent_style = tab
