# ============================================================
# .claudeignore — RedView App
# Empêche Claude de lire des fichiers inutiles pour économiser
# des tokens et garder le contexte pertinent.
# ============================================================


# ───────────────────────────────────────────────
# Dépendances & build (gros, jamais utiles)
# ───────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
dist-verify/
dist-*/

# Binaires Rust compilés
vendor/redviewalgo/target/
**/target/


# ───────────────────────────────────────────────
# Fichiers binaires & assets lourds
# ───────────────────────────────────────────────
# WebAssembly
*.wasm

# Images / médias
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
*.mp4
*.mp3
*.wav

# Polices
*.woff
*.woff2
*.ttf
*.eot

# Archives
*.zip
*.tar
*.gz
*.7z


# ───────────────────────────────────────────────
# Données géospatiales & JSON volumineux
# ───────────────────────────────────────────────
public/france-border.json
public/poi-icons/
public/images/
public/landing/
public/svgv2/
public/sw-dem/
public/project-browser/
public/control-panel/
public/right-click-icons/


# ───────────────────────────────────────────────
# Locks & fichiers générés automatiquement
# ───────────────────────────────────────────────
package-lock.json
yarn.lock
pnpm-lock.yaml

# Cache TypeScript
*.tsbuildinfo


# ───────────────────────────────────────────────
# Variables d'environnement & secrets
# ───────────────────────────────────────────────
.env
.env.*
!.env.example
COOLIFY.txt


# ───────────────────────────────────────────────
# Git & outils IDE
# ───────────────────────────────────────────────
.git/
.vscode/
.idea/
.DS_Store

# Caches IA / outils tiers
.claude-temp/
.figma-cache/
.workbuddy-ai/
.zcode/


# ───────────────────────────────────────────────
# Scripts de test & benchmark (non-prod)
# ───────────────────────────────────────────────
scripts/
script-test-bench/


# ───────────────────────────────────────────────
# Logs
# ───────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ───────────────────────────────────────────────
# Docker & infra
# ───────────────────────────────────────────────
Dockerfile
.dockerignore


# ───────────────────────────────────────────────
# Docs de recherche / audit (volumineux, rarement utiles)
# ───────────────────────────────────────────────
docs/architecture/overview.md
docs/audits/
docs/architecture/routing.md
docs/architecture/structure.md


# ───────────────────────────────────────────────
# Profils BRouter (fichiers de config volumineux)
# ───────────────────────────────────────────────
src/features/itineraryPanel/lib/brouter/profiles/brf-template/
