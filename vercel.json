{
  "rewrites": [
    { "source": "/api/lidar-zones", "destination": "/api/lidar-zones" },
    { "source": "/api/lidar-download", "destination": "/api/lidar-download" },
    { "source": "/lidar-viewer.html", "destination": "/lidar-viewer.html" },
    { "source": "/((?!api/|assets/|dem-tiles/|ortho-tiles/|sw-dem/|lidar-viewer).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw-dem.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw-dem/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/france-border.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
