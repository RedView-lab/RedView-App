{
  "functions": {
    "api/brouter.ts": { "maxDuration": 60 },
    "api/overpass.ts": { "maxDuration": 90 },
    "api/poi.ts": { "maxDuration": 30 },
    "api/geocode-iconic.ts": { "maxDuration": 15 },
    "api/openmeteo.ts": { "maxDuration": 30 },
    "api/meteofrance.ts": { "maxDuration": 60 },
    "api/billing/overview.ts": { "maxDuration": 15 },
    "api/billing/contact.ts": { "maxDuration": 15 },
    "api/billing/subscription.ts": { "maxDuration": 30 },
    "api/billing/payment-method.ts": { "maxDuration": 30 },
    "api/stripe/webhook.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/viewer", "destination": "/viewer.html" },
    { "source": "/api/openmeteo/(.*)", "destination": "/api/openmeteo" },
    { "source": "/((?!api/|assets/|dem-tiles/|ortho-tiles/|sw-dem/|viewer).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw-dem.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw-dem/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/france-border.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/viewer",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/((?!api/|assets/|dem-tiles/|ortho-tiles/|sw-dem/|viewer).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/viewer.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
