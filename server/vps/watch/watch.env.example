# /etc/redview-watch/watch.env — configuration de redview-watch (root, 0600).
# Modèle versionné : server/vps/watch/watch.env.example. install.sh ne
# l'écrase jamais une fois posé. Toute valeur absente prend le défaut du script.

# Pannes, rappels et retours en service, envoyés par Resend avec la clé de
# l'app (lue dans son conteneur, copie de secours dans resend.key).
ALERT_EMAIL_TO=runningsimon65@gmail.com
ALERT_EMAIL_FROM="RedView VPS <noreply@redview.tech>"
# Préfixe du nom du conteneur de l'app dans Coolify (uuid de l'application).
APP_CONTAINER_PREFIX=q7lznj8fhunybhvuvm3jcu0u-

# URL de ping de type healthchecks.io (période 5 min, grâce 10 min) : appelée
# à chaque passage (…/fail si une panne est confirmée). Sans elle, un VPS
# arrêté ou coupé du réseau n'alerte personne — ce script tourne dessus.
HEARTBEAT_URL=

# Alerte après 2 échecs d'affilée (≈ 10 min), rappel toutes les 6 h.
FAIL_THRESHOLD=2
REMIND_HOURS=6
# Seuils.
TLS_MIN_DAYS=14
WEATHER_MIN_AHEAD_H=48
BACKUP_MAX_AGE_H=30
DISK_MAX_PCT=90
MEM_MIN_PCT=25
