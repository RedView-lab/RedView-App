# /etc/redview-backup/backup.env — configuration de redview-backup (root, 0600).
# Modèle versionné : server/vps/backup/backup.env.example. install.sh ne
# l'écrase jamais une fois posé.

# Dépôt restic chiffré (AES-256), sur Google Drive via rclone.
RESTIC_REPOSITORY=rclone:gdrive-backup:RedView-Restic
# Mot de passe du dépôt. Sans lui, les sauvegardes sont illisibles : une copie
# doit exister HORS du VPS (gestionnaire de mots de passe, kit de reprise).
RESTIC_PASSWORD_FILE=/etc/redview-backup/restic-password
# Configuration rclone : remote `gdrive-backup`, client OAuth propre à RedView,
# scope drive.file (rclone ne voit que les fichiers qu'il a créés). README.md,
# « Accès Google Drive ».
RCLONE_CONFIG=/etc/redview-backup/rclone.conf
RESTIC_CACHE_DIR=/var/cache/redview-backup
# Paquets de 64 Mio : 4× moins de fichiers sur Drive qu'avec le défaut.
RESTIC_PACK_SIZE=64
RESTIC_COMPRESSION=auto
# Nom logique de la machine dans le dépôt : à garder après une reprise ailleurs
# pour que l'historique continue.
RESTIC_HOST=redview-vps

# Rétention : 7 quotidiennes, 5 hebdomadaires, 12 mensuelles.
KEEP_DAILY=7
KEEP_WEEKLY=5
KEEP_MONTHLY=12
# Contrôle hebdomadaire : 1/12 des données relu chaque semaine.
CHECK_SUBSETS=12
# Alerte si un instantané ou un dump fond de plus de 30 % d'un jour à l'autre.
ANOMALY_DROP_PCT=30

# Bases sauvegardées par dump logique : « moteur:conteneur ».
DUMPS="mariadb:appwrite-mariadb postgres:coolify-db postgres:glitchtip-db postgres:umami-db"

# Alertes (échec, anomalie) et rapport hebdomadaire, envoyés par Resend avec
# la clé de l'app (lue dans son conteneur, copie de secours dans resend.key).
ALERT_EMAIL_TO=runningsimon65@gmail.com
ALERT_EMAIL_FROM="RedView VPS <noreply@redview.tech>"
# Préfixe du nom du conteneur de l'app dans Coolify (uuid de l'application).
APP_CONTAINER_PREFIX=q7lznj8fhunybhvuvm3jcu0u-
# Facultatif : URL de type healthchecks.io, appelée à chaque sauvegarde
# (…/fail en cas d'échec). Elle détecte aussi une sauvegarde qui ne tourne plus.
HEARTBEAT_URL=
