# /etc/systemd/system/brouter.service — BRouter standalone (port 17777, 4 threads).
#
# Tas Java : 3 Go fixes. BRouter borne lui-même chaque calcul à son
# « memoryclass » (128 Mo, OsmNodesMap.isInMemoryBounds) ; le script officiel
# (misc/scripts/standalone/server.sh) tourne avec 128 Mo de tas pour 1 thread.
# Mesuré le 2026-10-05 avec l'ancien tas de 16 Go : 10,6 Mo seulement dans
# l'old gen, le reste n'était que déchets de young gen, et le pre-touch de
# 16 Go envoyait les autres services dans le swap à chaque redémarrage.
# 3 Go = ~6× le plafond des 4 calculs simultanés ; pré-touché, il compte aussi
# dans le plancher mémoire de l'instance Always Free (server/vps/README.md).
[Unit]
Description=BRouter Standalone Routing Server
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/brouter
LogsDirectory=brouter
# Journal à part, gardé 48 h (journald@brouter.conf) : une ligne par requête,
# avec ses coordonnées. Lecture : journalctl --namespace=brouter -u brouter
LogNamespace=brouter

# Segments (1,8 Go) lus une fois : ils restent dans le page cache tant que la RAM est libre.
ExecStartPre=/usr/bin/sh -c 'cat /opt/brouter/segments4/*.rd5 > /dev/null'

ExecStart=/usr/bin/java -Xms3g -Xmx3g -XX:+AlwaysPreTouch -XX:+UseG1GC -XX:MaxGCPauseMillis=50 -XX:+ExitOnOutOfMemoryError -Xlog:gc*:file=/var/log/brouter/gc.log:time,uptime,level,tags:filecount=5,filesize=10m -DmaxRunningTime=300 -cp /opt/brouter/brouter-server.jar btools.server.RouteServer /opt/brouter/segments4 /opt/brouter/profiles customprofiles 17777 4

Restart=always
RestartSec=5
# La JVM sort en 128 + 15 sur SIGTERM : un arrêt normal, pas un échec.
SuccessExitStatus=143
LimitNOFILE=65535

# Garde-fous : tas 3 Go + métaspace, code, piles, structures du GC ≈ 3,5 Go,
# plus le page cache des segments (1,8 Go), compté dans le cgroup du service :
# une limite plus basse le ferait évincer et BRouter relirait le disque.
# En cas de manque de mémoire, le noyau sacrifie un build Coolify plutôt que le routage.
MemoryMax=6G
OOMScoreAdjust=-300

[Install]
WantedBy=multi-user.target
