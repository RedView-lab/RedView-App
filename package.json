{
  "name": "redview-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build/prebuild-api-i18n.mjs && vite",
    "services": "node scripts/dev/start-dev-services.mjs",
    "services:stop": "node scripts/dev/stop-dev-services.mjs",
    "build": "node scripts/build/prebuild-api-i18n.mjs && tsc -b && vite build",
    "build:vite": "vite build",
    "build:server": "node scripts/build/build-server.mjs",
    "preview": "vite preview",
    "start": "tsx server.mjs",
    "check": "node scripts/quality/check.mjs",
    "check:full": "node scripts/quality/check.mjs --full",
    "typecheck": "node scripts/build/prebuild-api-i18n.mjs && tsc -b",
    "typecheck:bench": "tsc -p tsconfig.bench.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:prune": "eslint . --prune-suppressions",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --testTimeout=20000",
    "knip": "knip --no-progress",
    "cycles": "madge --circular --no-spinner src",
    "bundle:check": "node scripts/quality/check-bundle.mjs",
    "server:check": "node scripts/quality/check-server-bundle.mjs",
    "i18n:audit": "node scripts/quality/i18n-audit.mjs",
    "i18n:check": "node scripts/quality/i18n-audit.mjs --strict",
    "e2e:journey": "tsx script-test-bench/user-journey/run.ts",
    "bench": "tsx --expose-gc script-test-bench/run-all-benchmarks.ts",
    "bench:quick": "tsx --expose-gc script-test-bench/run-all-benchmarks.ts --quick",
    "bench:meteo": "tsx script-test-bench/suites/meteo.ts",
    "bench:pente": "tsx script-test-bench/suites/pente.ts",
    "bench:alti": "tsx script-test-bench/suites/alti.ts",
    "bench:dem-sw": "tsx script-test-bench/suites/dem-sw.ts",
    "bench:neige": "tsx script-test-bench/suites/neige.ts",
    "bench:snow": "tsx script-test-bench/snow-quality/run.ts",
    "bench:snow:image": "tsx script-test-bench/snow-quality/render.ts",
    "bench:brouter": "tsx script-test-bench/suites/brouter.ts",
    "bench:routing": "tsx script-test-bench/routing-quality/run.ts",
    "bench:routing:sweep": "tsx script-test-bench/routing-quality/sweep.ts",
    "bench:routing:compare": "tsx script-test-bench/routing-quality/compare.ts",
    "bench:routing:report": "tsx script-test-bench/routing-quality/report-html.ts",
    "bench:fit": "tsx script-test-bench/suites/fit-predictor.ts",
    "bench:pace": "tsx script-test-bench/pace-accuracy/run.ts",
    "bench:pace:prep": "tsx script-test-bench/pace-accuracy/prep.ts",
    "bench:pace:realism": "tsx script-test-bench/pace-accuracy/realism.ts",
    "bench:lidar": "tsx script-test-bench/suites/lidar.ts",
    "bench:lidar-lod": "tsx script-test-bench/lidar-lod/run.ts",
    "bench:lidar-fps": "node script-test-bench/lidar-viewer-perf/run.mjs",
    "bench:lidar-shots": "node script-test-bench/lidar-viewer-shots/run.mjs",
    "bench:lidar-engines": "node script-test-bench/lidar-viewer-engines/run.mjs",
    "bench:avalanche": "tsx script-test-bench/avalanche/run.ts",
    "bench:poi": "tsx script-test-bench/suites/poi.ts",
    "bench:poi-autosort": "tsx script-test-bench/regression/poi-autosort.ts",
    "bench:exporter": "tsx script-test-bench/suites/exporter.ts",
    "bench:redview": "tsx script-test-bench/regression/redview-file.ts",
    "bench:project-layers": "tsx script-test-bench/regression/project-layers.ts",
    "bench:chart": "tsx script-test-bench/suites/center-panel.ts",
    "bench:analysis-chart": "tsx ./script-test-bench/suites/analysis-chart-cache.mjs",
    "bench:flyover": "tsx script-test-bench/flyover/run.ts",
    "bench:follow": "tsx script-test-bench/follow/playout.ts && tsx script-test-bench/follow/frames/run.ts",
    "bench:follow-frames": "tsx script-test-bench/follow/frames/run.ts",
    "bench:collab": "tsx script-test-bench/regression/collab.ts",
    "bench:collab-load": "tsx script-test-bench/collab-load/run.ts",
    "bench:collab-e2e": "node script-test-bench/collab-e2e/run.mjs",
    "bench:comments-viewer": "node script-test-bench/collab-e2e/comments-viewer.mjs",
    "bench:collab-prod": "node --env-file=.env script-test-bench/collab-e2e/prod-two-accounts.mjs",
    "bench:collab-trace": "node --env-file=.env script-test-bench/collab-e2e/prod-reopen-trace.mjs",
    "bench:server": "tsx script-test-bench/suites/server-api.ts",
    "bench:dashboard": "tsx script-test-bench/dashboard-perf/run.ts",
    "bench:screens": "node script-test-bench/screen-audit/run.mjs",
    "analytics:sync": "tsx scripts/analytics/umami/sync.ts",
    "analytics:report": "tsx --env-file=.env scripts/analytics/activation-report.ts --usage",
    "collab:test-accounts": "node --env-file=.env scripts/appwrite/collab-test-accounts.mjs",
    "lidar:index": "node scripts/lidar-index/build.mjs",
    "workbench": "node scripts/design-workbench/build.mjs",
    "workbench:verify": "node scripts/design-workbench/verify.mjs",
    "test:openmeteo:vps": "node ./scripts/probes/openmeteo-vps.mjs",
    "deploy": "node scripts/release/deploy.mjs",
    "push": "node scripts/release/deploy.mjs",
    "rollback": "node scripts/release/rollback.mjs"
  },
  "dependencies": {
    "@mattnucc/gribberish": "^0.30.2",
    "@sentry/node": "^10.76.0",
    "fractional-indexing": "^4.0.0",
    "node-appwrite": "^29.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "stripe": "^22.0.1",
    "ws": "8.21.0"
  },
  "overrides": {
    "protocol-buffers-schema": "3.6.1",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "ws": "$ws"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/rethink-sans": "^5.3.0",
    "@garmin/fitsdk": "^21.217.0",
    "@mapbox/mapbox-gl-draw": "^1.5.2",
    "@photostructure/tz-lookup": "^11.7.0",
    "@sentry/react": "^10.75.1",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^5.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@webgpu/types": "^0.1.74",
    "appwrite": "^26.2.0",
    "axe-core": "^4.14.0",
    "copc": "^0.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "20.14.5",
    "knip": "^6.39.0",
    "madge": "^8.0.0",
    "mapbox-gl": "3.32.0",
    "martinez-polygon-clipping": "^0.9.0",
    "mediabunny": "^1.61.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
