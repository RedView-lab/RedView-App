{
  "name": "redview-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bench": "tsx --expose-gc script-test-bench/run-all-benchmarks.ts",
    "bench:quick": "tsx --expose-gc script-test-bench/run-all-benchmarks.ts --quick",
    "bench:meteo": "tsx script-test-bench/bench-meteo.ts",
    "bench:pente": "tsx script-test-bench/bench-pente.ts",
    "bench:alti": "tsx script-test-bench/bench-alti.ts",
    "bench:neige": "tsx script-test-bench/bench-neige.ts",
    "bench:brouter": "tsx script-test-bench/bench-brouter.ts",
    "bench:fit": "tsx script-test-bench/bench-fit-predictor.ts",
    "bench:lidar": "tsx script-test-bench/bench-lidar.ts",
    "bench:poi": "tsx script-test-bench/bench-poi.ts",
    "bench:exporter": "tsx script-test-bench/bench-exporter.ts",
    "bench:chart": "tsx script-test-bench/bench-center-panel.ts",
    "bench:server": "tsx script-test-bench/bench-server-api.ts",
    "bench:analysis-chart": "node --experimental-strip-types ./scripts/benchmark-analysis-chart-cache.mjs",
    "dev": "node scripts/prebuild-api-i18n.mjs && vite",
    "services": "node scripts/start-dev-services.mjs",
    "services:stop": "node scripts/stop-dev-services.mjs",
    "build": "node scripts/prebuild-api-i18n.mjs && tsc -b && vite build",
    "test:openmeteo:vps": "node ./scripts/test-openmeteo-vps.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "tsx server.mjs",
    "push": "node scripts/deploy.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.201.0",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@mattnucc/gribberish": "^0.30.2",
    "@sentry/react": "^10.75.1",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^5.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/proj4": "^2.5.6",
    "@webgpu/types": "^0.1.69",
    "appwrite": "^26.2.0",
    "copc": "^0.0.8",
    "exceljs": "^4.4.0",
    "mapbox-gl": "^3.21.0",
    "node-appwrite": "^29.0.0",
    "nodemailer": "^10.0.1",
    "proj4": "^2.20.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stripe": "^22.0.1",
    "tsx": "^4.19.3"
  },
  "overrides": {
    "protocol-buffers-schema": "3.6.1",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
